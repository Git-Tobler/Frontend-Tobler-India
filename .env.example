# =============================================================================
# WHICH PREFIX A VARIABLE HAS IS A SECURITY DECISION, NOT A STYLE ONE.
#
# Vite compiles every VITE_* value directly into the JavaScript bundle it ships
# to the browser. Anyone can read them: View Source, or DevTools -> Network.
# There is no way to hide a VITE_* value. Anything without the prefix is never
# exposed to the client at all — Vite refuses to.
#
# So: VITE_* is for things that are fine in public. Everything else stays bare.
# =============================================================================


# -----------------------------------------------------------------------------
# EmailJS — delivers the General Enquiry and Request a Quote forms to a mailbox.
#
# These are read ONLY by api/enquiry.js, a serverless function that runs on
# Vercel. The browser never sees them and never talks to EmailJS directly; it
# POSTs the form to /api/enquiry on our own origin and the function relays it.
#
# This is why none of them carry a VITE_ prefix. The site used to call EmailJS
# from the page, which meant the service id, template ids and public key were
# all in the bundle and readable by anyone who submitted the form. That is
# unavoidable for any browser-side mail service — EmailJS's own documentation
# says the public key "is visible in browser requests" — so the fix was to move
# the call to a server, not to try to hide the key better.
#
# WHERE EACH VALUE COMES FROM:
#   Service ID   -> EmailJS dashboard > Email Services. Connect the Outlook
#                   account there; that connection is what puts mail in Outlook.
#   Template IDs -> EmailJS dashboard > Email Templates, one per form.
#   Public Key   -> EmailJS dashboard > Account > General > Public Key.
#   Private Key  -> EmailJS dashboard > Account > API Keys. You must first turn
#                   ON "Allow EmailJS API for non-browser applications" — the
#                   private key only appears once that is enabled, and without
#                   it EmailJS rejects every server-origin call with a 403.
#
# ALSO DO THIS, in the EmailJS dashboard:
#   - Account > Security > set Allowed Origins to your own domain.
#   - Set a sending quota, so a bot that gets past the honeypot cannot drain
#     the month's allowance in one run.
#
# IN PRODUCTION these belong in the Vercel dashboard (Project Settings >
# Environment Variables), NOT in a file in the repo.
#
# LOCALLY they do nothing under `npm run dev` — Vite's dev server does not run
# serverless functions, so the forms fall back to their mailto handoff. Use
# `vercel dev` or a preview deployment to exercise the real path.
# -----------------------------------------------------------------------------
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_CONTACT_TEMPLATE_ID=your_contact_template_id
EMAILJS_RFQ_TEMPLATE_ID=your_rfq_template_id
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key

# Optional. The inbox enquiries are addressed to, surfaced to the EmailJS
# template as {{to_email}}. Leave unset to use the address in src/data/site.js
# (info@tobler-india.com). Only takes effect if the template's "To email" field
# is set to {{to_email}}.
CONTACT_RECIPIENT=


# -----------------------------------------------------------------------------
# Cloudinary — all site photography and video.
#
# The cloud name is genuinely public: it appears in every image URL the page
# renders, so VITE_ is correct here and hiding it would achieve nothing.
#
# The API key and secret are NOT public. They are read only by the scripts in
# scripts/ (fetch-cloudinary.mjs and friends) when run by hand from a terminal,
# never by the site. They must never gain a VITE_ prefix, and they do not need
# to be set in Vercel at all — the build does not use them.
# -----------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
Cloudinary_API_KEY=your_api_key
Cloudinary_API_SECRET=your_api_secret
