# EmailJS — delivers the General Enquiry and Request a Quote forms to a mailbox.
# Without all four of these set, both forms refuse to submit and show their
# error state; they do NOT silently pretend to have sent.
#   Service ID   -> EmailJS dashboard > Email Services (connect the Outlook
#                   account there; that connection is what puts mail in Outlook)
#   Template IDs -> EmailJS dashboard > Email Templates, one per form
#   Public key   -> EmailJS dashboard > Account > General > Public Key
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_CONTACT_TEMPLATE_ID=your_contact_template_id
VITE_EMAILJS_RFQ_TEMPLATE_ID=your_rfq_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Optional. The inbox enquiries are addressed to, surfaced to the EmailJS
# template as {{to_email}}. Leave unset to use SITE.email (info@tobler-india.com).
# Only takes effect if the template's "To email" field is set to {{to_email}}.
VITE_CONTACT_RECIPIENT=

# Cloudinary — only the cloud name reaches the browser. The API key/secret are
# read by scripts/fetch-cloudinary.mjs at build time and must never be VITE_*.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
Cloudinary_API_KEY=your_api_key
Cloudinary_API_SECRET=your_api_secret
